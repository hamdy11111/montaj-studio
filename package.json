{
  "name": "montaj-studio",
  "productName": "Montaj Studio",
  "version": "1.2.0",
  "description": "Offline desktop video editor built from the CapCut 9.6 reconstruction blueprint (Electron + Realm, no UI framework).",
  "type": "module",
  "main": "src/main/main.js",
  "author": "Hamdy Gaber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hamdy11111/montaj-studio.git"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e",
    "traceability": "node scripts/traceability.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "ajv": "8.17.1",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "realm": "20.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.64.1"
  },
  "build": {
    "appId": "studio.montaj.desktop",
    "productName": "Montaj Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/realm/prebuilds/android/**",
      "!node_modules/realm/prebuilds/apple/**",
      "!node_modules/realm/react-native/**",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/realm/**/*.node",
      "src/services/asr/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/bin/win32/x64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Montaj Studio"
    },
    "fileAssociations": [
      {
        "ext": "mstudio",
        "name": "Montaj Studio package",
        "role": "Editor"
      }
    ],
    "npmRebuild": false
  },
  "allowScripts": {
    "realm@20.2.0": true,
    "electron@45.0.0": true,
    "ffmpeg-static@5.3.0": true,
    "electron-builder@26.15.3": true
  }
}
