{
  "name": "montaj-studio",
  "productName": "Montaj Studio",
  "version": "1.13.0",
  "description": "Offline desktop video editor built from the CapCut 9.6 reconstruction blueprint (Electron + Realm, no UI framework).",
  "type": "module",
  "main": "src/main/main.js",
  "author": "Hamdy Gaber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hamdy11111/montaj-studio.git"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e",
    "traceability": "node scripts/traceability.js",
    "setup:asr": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-asr.ps1",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis --publish never",
    "setup:graphics": "node src/graphics/setup.js",
    "build:graphics": "node src/graphics/build.js",
    "predist": "node src/graphics/build.js",
    "prepack": "node src/graphics/build.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@remotion/renderer": "4.0.538",
    "ajv": "8.17.1",
    "electron-updater": "6.8.11",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "realm": "20.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@remotion/animated-emoji": "4.0.538",
    "@remotion/bundler": "4.0.538",
    "@remotion/fonts": "4.0.538",
    "@remotion/gsap": "4.0.538",
    "@remotion/layout-utils": "4.0.538",
    "@remotion/lottie": "4.0.538",
    "@remotion/motion-blur": "4.0.538",
    "@remotion/noise": "4.0.538",
    "@remotion/paths": "4.0.538",
    "@remotion/player": "4.0.538",
    "@remotion/rough-notation": "4.0.538",
    "@remotion/shapes": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "lottie-web": "5.13.0",
    "playwright-core": "1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538"
  },
  "build": {
    "appId": "studio.montaj.desktop",
    "productName": "Montaj Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/__pycache__/**",
      "!src/services/asr/models/**",
      "!node_modules/realm/prebuilds/android/**",
      "!node_modules/realm/prebuilds/apple/**",
      "!node_modules/realm/react-native/**",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/realm/**/*.node",
      "src/services/asr/**",
      "src/services/vision/**",
      "src/services/audio/**",
      "src/services/dub/**",
      "src/services/music/**",
      "src/services/video/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/bin/win32/x64/**",
      "src/graphics/build/**",
      "node_modules/@remotion/compositor-win32-x64-msvc/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hamdy11111",
        "repo": "montaj-studio",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Montaj Studio",
      "artifactName": "Montaj-Studio-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "mstudio",
        "name": "Montaj Studio package",
        "role": "Editor"
      }
    ],
    "npmRebuild": false
  },
  "allowScripts": {
    "realm@20.2.0": true,
    "electron@45.0.0": true,
    "ffmpeg-static@5.3.0": true,
    "electron-builder@26.15.3": true
  }
}
